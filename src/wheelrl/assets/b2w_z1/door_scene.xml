<mujoco model="unitree_b2w_z1_pull_door">
  <include file="b2w_z1.xml"/>

  <statistic center="0.55 0 0.9" extent="2.0"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="125" elevation="-16"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.5 0.7" rgb2="0.02 0.03 0.05"
      width="512" height="3072"/>
    <texture type="2d" name="door_groundplane" builtin="checker" mark="edge"
      rgb1="0.28 0.32 0.36" rgb2="0.12 0.15 0.18" markrgb="0.8 0.8 0.8"
      width="300" height="300"/>
    <material name="door_groundplane" texture="door_groundplane" texuniform="true"
      texrepeat="8 8" reflectance="0.1"/>
    <material name="door_panel_material" rgba="0.46 0.27 0.12 1"/>
    <material name="door_frame_material" rgba="0.18 0.20 0.23 1"/>
    <material name="door_handle_material" rgba="0.75 0.77 0.80 1"
      specular="0.6" shininess="0.5"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="door_groundplane"
      friction="0.9 0.02 0.001"/>

    <!-- Pose marker used by the traditional Mink IK controller. -->
    <body name="tcp_target" mocap="true" pos="1.0 -0.6 1.18">
      <geom type="sphere" size="0.022" rgba="1 0.85 0.1 0.75"
        contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.006 0.045" pos="0.045 0 0"
        euler="0 1.570796327 0" rgba="0.95 0.15 0.15 0.9"
        contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.006 0.045" pos="0 0.045 0"
        euler="-1.570796327 0 0" rgba="0.15 0.95 0.15 0.9"
        contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.006 0.045" pos="0 0 0.045"
        rgba="0.15 0.35 1 0.9" contype="0" conaffinity="0"/>
    </body>

    <!-- The robot begins on the negative-x side and pulls the door toward itself. -->
    <body name="door_frame" pos="1.10 0.65 0">
      <geom name="door_frame_hinge_post" type="box" pos="0.12 0 1.05"
        size="0.075 0.075 1.05" material="door_frame_material"/>
      <geom name="door_frame_latch_post" type="box" pos="0.12 -1.40 1.05"
        size="0.075 0.075 1.05" material="door_frame_material"/>
      <geom name="door_frame_header" type="box" pos="0.12 -0.70 2.10"
        size="0.075 0.775 0.075" material="door_frame_material"/>

      <body name="door_panel">
        <joint name="door_hinge_joint" type="hinge" axis="0 0 1"
          range="-1.45 0.02" damping="1.2" armature="0.08"/>
        <inertial pos="0 -0.70 1.05" mass="32"
          diaginertia="18.2 11.9 6.5"/>
        <geom name="door_panel_collision" type="box" pos="0 -0.70 1.05"
          size="0.032 0.70 1.00" material="door_panel_material"
          friction="0.8 0.02 0.002"/>
        <geom name="door_latch_tongue" type="box" pos="-0.055 -1.392 1.18"
          size="0.04 0.025 0.035" material="door_handle_material"
          contype="0" conaffinity="0"/>

        <!-- Positive handle angle moves the lever down and releases the latch. -->
        <body name="door_handle" pos="-0.070 -1.12 1.18">
          <joint name="door_handle_joint" type="hinge" axis="1 0 0"
            range="0 0.90" damping="0.08" armature="0.002"/>
          <inertial pos="0 -0.075 0" mass="0.35"
            diaginertia="0.0018 0.0007 0.0018"/>
          <geom name="door_handle_hub" type="cylinder" pos="0 0 0"
            size="0.040 0.025" euler="0 1.570796327 0"
            material="door_handle_material" friction="1.3 0.02 0.002"/>
          <geom name="door_handle_lever" type="capsule" fromto="0 0 0 0 -0.18 0"
            size="0.025" material="door_handle_material"
            friction="1.5 0.02 0.002"/>
          <site name="door_handle_grasp" pos="0 -0.13 0" size="0.022"
            rgba="0.95 0.20 0.10 0.65"/>
        </body>
      </body>
    </body>
  </worldbody>

  <!--
    A soft grasp constraint compensates for the simplified one-DoF gripper
    collision mesh. Runtime code activates it only after the gripper closes
    inside the handle region and releases it when the gripper opens.
  -->
  <equality>
    <connect name="gripper_handle_connect" site1="z1_ee" site2="door_handle_grasp"
      active="false" solref="0.06 1" solimp="0.80 0.95 0.004"/>
  </equality>
</mujoco>
