<mujoco model="unitree_b2w_z1_wbc_scene">
  <include file="b2w_z1.xml"/>

  <statistic center="0.1 0 0.55" extent="1.6"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-125" elevation="-18"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.5 0.7" rgb2="0.02 0.03 0.05"
      width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.28 0.32 0.36" rgb2="0.12 0.15 0.18" markrgb="0.8 0.8 0.8"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
      texrepeat="8 8" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"
      friction="0.9 0.02 0.001"/>

    <!-- A mocap triad makes the commanded TCP SE(3) pose visible. -->
    <body name="tcp_target" mocap="true" pos="0.65 0 1.1">
      <geom type="sphere" size="0.024" rgba="1 0.85 0.1 0.75"
        contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.008 0.055" pos="0.055 0 0"
        euler="0 1.570796327 0" rgba="0.95 0.15 0.15 0.9"
        contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.008 0.055" pos="0 0.055 0"
        euler="-1.570796327 0 0" rgba="0.15 0.95 0.15 0.9"
        contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.008 0.055" pos="0 0 0.055"
        rgba="0.15 0.35 1 0.9" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <!--
    The assumed Z1 bracket overlaps the conservative B2-W top-deck/lidar
    collision box when joint 1 turns. Ignore only this proximal mounting pair
    in the WBC demo; distal arm/base self-collisions remain enabled.
  -->
  <contact>
    <exclude body1="base_link" body2="z1_link02"/>
  </contact>
</mujoco>
